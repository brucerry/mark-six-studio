if(NOT EXISTS "${INPUT}")
  message(FATAL_ERROR "Native maintenance helper is missing")
endif()
file(SHA256 "${INPUT}" digest)
set(content "${digest}\n")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" previous)
else()
  set(previous "")
endif()
if(NOT previous STREQUAL content)
  file(WRITE "${OUTPUT}" "${content}")
endif()
